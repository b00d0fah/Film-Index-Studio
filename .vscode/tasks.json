{
  "version": "2.0.0",
  "tasks": [
    { "label": "Film Index: Build and Test", "type": "process", "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Test"], "group": {"kind":"build","isDefault":true}, "problemMatcher": "$gcc" },
    { "label": "Film Index: Debug Build", "type": "process", "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Configuration", "Debug"], "problemMatcher": "$gcc" },
    { "label": "Film Index: Release Package", "type": "process", "command": "powershell", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1", "-Test", "-Deploy"], "problemMatcher": "$gcc" }
  ]
}
